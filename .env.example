# ==============================================================================
# MacBook Air M2 - Asistan Ortam Değişkenleri
# ==============================================================================

# === 1. Google Gemini Cloud Brain (Varsayılan & 0 MB RAM) ===
# Google AI Studio'dan aldığınız ücretsiz API anahtarı:
# https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# === 2. Yerel Ollama Brain (Çevrimdışı / Fallback) ===
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_KEEP_ALIVE=5m

# === 3. Beyin Modu Seçimi ===
# "auto": İnternet varsa Gemini Cloud (0 RAM), yoksa Yerel Ollama
# "cloud": Sadece Gemini Cloud API
# "local": Sadece yerel Ollama
BRAIN_MODE=auto

# === 4. Hedef Tarayıcı ve Otomasyon ===
TARGET_BROWSER=Yandex
HOTKEY=<alt>+<space>
VAD_SILENCE_SECONDS=1.5

# === 5. Debug ve Loglama ===
DEBUG=false
